<?xml version="1.0" encoding="utf-8"?>
<!-- Server ZARR CHAT memakai http:// (bukan https), jadi lalu lintas cleartext harus diizinkan. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
